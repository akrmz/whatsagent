# WhatsApp bot configuration. Copy to .env and edit:  cp .env.example .env
# Lines starting with # are comments. Empty values mean "use the default".
# Never commit the real .env file. Restart the bot after changing it.
#
# Most settings (AI keys and models, API keys, bot name, prefix, limits, tool paths) can
# also be changed from WhatsApp by the owner, without a restart: .vars lists them,
# .setvar NAME value changes one, .setai sets up the AI. Those override this file.

# =============================================================================
# REQUIRED
# =============================================================================

# Your WhatsApp number(s), full international format, digits only, no leading 0.
# Example for Egypt 010 1234 5678 → 201012345678. Separate several with commas.
OWNER_NUMBERS=

# =============================================================================
# Identity and behaviour
# =============================================================================

# Name shown in .help, .alive and .ping, and your name on the .owner contact card.
BOT_NAME=WhatsApp Bot
OWNER_NAME=Owner

# Character(s) that start a command (1-3 characters).
PREFIX=.

# Mode used on first start only (afterwards .mode public|private is remembered).
# public = everyone can use commands; private = only owner and sudo.
MODE=public

# Your WhatsApp "LID" ids (digits only), if groups show you as an @lid user and the
# bot does not recognise you as owner there. Send .whoami in a group to see them.
OWNER_LIDS=

# Show the bot account as "online" while connected (true/false).
MARK_ONLINE=true

# Sticker pack name and author written into stickers the bot creates.
STICKER_PACK=
STICKER_AUTHOR=

# Time zone for .time, .remind, .autoazkar, .autotafsir … (IANA name, e.g. Africa/Cairo).
# Empty: the server's zone; if the server runs on UTC (usual for a VPS), the zone of the
# owner's country, from OWNER_NUMBERS (20… → Africa/Cairo). Set it if that guess is wrong.
TIMEZONE=
# Default region for .news, as COUNTRY:language (e.g. EG:ar, SA:ar, US:en, GB:en, FR:fr).
NEWS_REGION=US:en
# Reply "did you mean .sticker?" to a mistyped command (once per chat a minute).
SUGGEST_COMMANDS=true
# true: only group admins may switch .autoazkar / .autoprayer / .autotafsir in groups.
# false (default): any member may.
ISLAMIC_ADMIN_ONLY=false

# =============================================================================
# Pairing (only needed the first time, or after being logged out)
# =============================================================================

# Set this to your bot's WhatsApp number to get an 8-character pairing code in the
# bot's console/log. Leave empty if you use the pairing service instead.
# Remove it again after pairing.
PAIRING_NUMBER=

# =============================================================================
# Self-update (.update / .update now, owner only)
# =============================================================================

# The bot updates only from this remote and branch of the git clone it runs from
# (normally your GitHub repository). Only fast-forward updates are applied.
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

# =============================================================================
# Folders (relative to MD-main/ unless absolute)
# =============================================================================

# Session = your WhatsApp login. Back it up and keep it private.
SESSION_DIR=session
# Bot settings (mode, sudo list, group settings, warnings, bans).
DATA_DIR=data
# Temporary files (cleaned automatically).
TMP_DIR=tmp

# =============================================================================
# Logging and health check
# =============================================================================

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty (coloured, for terminals) | json (for PM2/Docker log collection). Default: pretty on a terminal, json otherwise.
LOG_FORMAT=
# Baileys (WhatsApp library) internal logs. Keep "silent" unless debugging.
BAILEYS_LOG_LEVEL=silent

# GET http://HEALTH_HOST:HEALTH_PORT/healthz → 200 when connected, 503 otherwise. 0 disables it.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000

# =============================================================================
# Limits
# =============================================================================

# Largest WhatsApp media the bot will download for a command (MB).
MAX_MEDIA_MB=25
# Largest file a downloader command (.song, .video, .tiktok …) may fetch (MB).
MAX_DOWNLOAD_MB=50
# Longest audio/video a downloader command may fetch (seconds).
MAX_VIDEO_SECONDS=600
# Default seconds between uses of the same command by the same person (owner/sudo exempt).
DEFAULT_COOLDOWN_SECONDS=3
# Warnings before a member is removed (.warn, antilink/antibadword "warn" action).
WARN_LIMIT=3
# Downloads/conversions (yt-dlp, ffmpeg) running at the same time; more wait in a queue.
# Raise it on a strong server, keep 1-2 on a small VPS or phone.
MAX_PARALLEL_JOBS=2
# Commands one person may run per minute, across all commands (owner and sudo exempt).
# Protects the bot's number from being flagged for spam. 0 = no limit.
COMMANDS_PER_MINUTE=15
# Recent messages kept in memory for .delete (chats × messages per chat).
STORE_MAX_CHATS=500
STORE_MESSAGES_PER_CHAT=20
# Antidelete: messages remembered, and largest media copy kept (MB, 0 = text only).
ANTIDELETE_MAX_MESSAGES=5000
ANTIDELETE_MAX_MEDIA_MB=10

# =============================================================================
# External tools (installed separately, see docs/DEPLOYMENT.md)
# =============================================================================

# ffmpeg is needed for stickers, audio and .toaudio/.tovn; yt-dlp for .song/.video/.yts/.dl/
# .tiktok/.fb/.instagram/.twitter/.igs. Use the standalone yt-dlp nightly binary in a folder
# the bot user owns (e.g. ~/.local/bin), so ".update now" can update it.
# Either a program name found in PATH, or a full path; "~" means your home folder:
#   YTDLP_PATH=~/.local/bin/yt-dlp
# Check with: npm run check   (prints ✓/✗ for each tool and why), or send .doctor
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Update yt-dlp to the latest nightly automatically once a day (only yt-dlp, never the bot).
YTDLP_AUTO_UPDATE=false
# Optional cookies.txt (Netscape format) for every site, so yt-dlp can fetch login-only
# content. Easier: send per-site cookies from WhatsApp (private chat): .setcookie youtube
# (attach the cookies.txt). Per-site cookies win over this file. Treat it like a password.
YTDLP_COOKIES=
# Bold TTF font used by .attp.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# =============================================================================
# AI — .ai, .summarize and the group .chatbot. Disabled when the chosen AI has no key.
# Easiest: set it from WhatsApp in a private chat with the bot:  .setai gemini <key>
# (saved in DATA_DIR/env-overrides.json, overrides this file; see docs/USAGE.md).
# =============================================================================

# auto (first provider below that has a key) | claude | gemini | openai
AI_PROVIDER=auto

# Claude — https://console.anthropic.com/ (billed to your account)
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. (AI_MODEL is the old name of this setting and still works.)
CLAUDE_MODEL=

# Gemini — https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=
# Default gemini-3.8-flash. Send .aimodel to list the models your key can use.
GEMINI_MODEL=

# OpenAI, or any OpenAI-compatible service (Groq, OpenRouter, DeepSeek, Mistral …)
OPENAI_API_KEY=
# Default https://api.openai.com/v1. Must be https. Examples:
#   https://api.groq.com/openai/v1   https://openrouter.ai/api/v1   https://api.deepseek.com/v1
OPENAI_BASE_URL=
# Default gpt-6-luna (for other services, set their model name).
OPENAI_MODEL=

# Claude only: low | medium | high | xhigh | max  (higher = slower, more thorough, more expensive)
AI_EFFORT=low
# Maximum length of an AI answer, in tokens.
AI_MAX_TOKENS=1024
# AI requests per person per day (owner and sudo are exempt; a picture counts as 5). 0 = unlimited.
AI_DAILY_LIMIT=50
# Earlier question/answer pairs .ai and the chatbot remember (kept in memory only, 30 min). 0 = none.
AI_MEMORY_TURNS=6
# .imagine (pictures) and .transcribe (voice notes) use Gemini or OpenAI, whichever has a key.
# Defaults: gemini-3.1-flash-image, gpt-image-2.5-flare, gpt-transcribe.
GEMINI_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# Personality/instructions for the group chatbot.
CHATBOT_PERSONA=

# =============================================================================
# Optional API keys. A command whose key is empty is disabled and hidden from .help.
# Use YOUR OWN keys; never reuse keys found in old code.
# =============================================================================

# No longer needed: .news now uses Google News (no key). Kept so old .env files still load.
NEWSAPI_KEY=
# No longer needed: .weather now uses Open-Meteo (free, no key). Kept so old .env files still load.
OPENWEATHER_KEY=
# .emojimix — Google Cloud API key with the Tenor API enabled
TENOR_KEY=
# .tg — your own Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# .removebg — https://www.remove.bg/api
REMOVEBG_API_KEY=
# .remini — api.princetechn.com key
REMINI_API_KEY=
# .github — your repository as owner/name, e.g. myname/my-bot
GITHUB_REPO=
