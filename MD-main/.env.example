# WhatsApp bot configuration. Copy to .env and edit:  cp .env.example .env
# Lines starting with # are comments. Empty values mean "use the default".
# Never commit the real .env file. Restart the bot after changing it.

# =============================================================================
# REQUIRED
# =============================================================================

# Your WhatsApp number(s), full international format, digits only, no leading 0.
# Example for Egypt 010 1234 5678 → 201012345678. Separate several with commas.
OWNER_NUMBERS=

# =============================================================================
# Identity and behaviour
# =============================================================================

# Name shown in .help, .alive and .ping, and your name on the .owner contact card.
BOT_NAME=WhatsApp Bot
OWNER_NAME=Owner

# Character(s) that start a command (1-3 characters).
PREFIX=.

# Mode used on first start only (afterwards .mode public|private is remembered).
# public = everyone can use commands; private = only owner and sudo.
MODE=public

# Your WhatsApp "LID" ids (digits only), if groups show you as an @lid user and the
# bot does not recognise you as owner there. Send .whoami in a group to see them.
OWNER_LIDS=

# Show the bot account as "online" while connected (true/false).
MARK_ONLINE=true

# Sticker pack name and author written into stickers the bot creates.
STICKER_PACK=
STICKER_AUTHOR=

# =============================================================================
# Pairing (only needed the first time, or after being logged out)
# =============================================================================

# Set this to your bot's WhatsApp number to get an 8-character pairing code in the
# bot's console/log. Leave empty if you use the pairing service instead.
# Remove it again after pairing.
PAIRING_NUMBER=

# =============================================================================
# Self-update (.update / .update now, owner only)
# =============================================================================

# The bot updates only from this remote and branch of the git clone it runs from
# (normally your GitHub repository). Only fast-forward updates are applied.
UPDATE_REMOTE=origin
UPDATE_BRANCH=main

# =============================================================================
# Folders (relative to MD-main/ unless absolute)
# =============================================================================

# Session = your WhatsApp login. Back it up and keep it private.
SESSION_DIR=session
# Bot settings (mode, sudo list, group settings, warnings, bans).
DATA_DIR=data
# Temporary files (cleaned automatically).
TMP_DIR=tmp

# =============================================================================
# Logging and health check
# =============================================================================

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty (coloured, for terminals) | json (for PM2/Docker log collection). Default: pretty on a terminal, json otherwise.
LOG_FORMAT=
# Baileys (WhatsApp library) internal logs. Keep "silent" unless debugging.
BAILEYS_LOG_LEVEL=silent

# GET http://HEALTH_HOST:HEALTH_PORT/healthz → 200 when connected, 503 otherwise. 0 disables it.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000

# =============================================================================
# Limits
# =============================================================================

# Largest WhatsApp media the bot will download for a command (MB).
MAX_MEDIA_MB=25
# Largest file a downloader command (.song, .video, .tiktok …) may fetch (MB).
MAX_DOWNLOAD_MB=50
# Longest audio/video a downloader command may fetch (seconds).
MAX_VIDEO_SECONDS=600
# Default seconds between uses of the same command by the same person (owner/sudo exempt).
DEFAULT_COOLDOWN_SECONDS=3
# Warnings before a member is removed (.warn, antilink/antibadword "warn" action).
WARN_LIMIT=3
# Recent messages kept in memory for .delete (chats × messages per chat).
STORE_MAX_CHATS=500
STORE_MESSAGES_PER_CHAT=20
# Antidelete: messages remembered, and largest media copy kept (MB, 0 = text only).
ANTIDELETE_MAX_MESSAGES=5000
ANTIDELETE_MAX_MEDIA_MB=10

# =============================================================================
# External tools (installed separately, see docs/DEPLOYMENT.md)
# =============================================================================

# ffmpeg is needed for stickers; yt-dlp for .song/.video/.tiktok/.fb/.instagram/.igs.
# Use the standalone yt-dlp nightly binary in a folder the bot user owns (e.g. ~/.local/bin),
# so ".update now" can update it.
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
# Optional cookies.txt (Netscape format) so yt-dlp can fetch login-only content
# (e.g. some Instagram posts). Treat this file like a password.
YTDLP_COOKIES=
# Bold TTF font used by .attp.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# =============================================================================
# AI (Claude) — .ai/.gpt/.gemini and the group .chatbot. Disabled when empty.
# Get a key at https://console.anthropic.com/  (usage is billed to your account)
# =============================================================================

ANTHROPIC_API_KEY=
# Model id. Default claude-opus-5-5 (most capable). claude-sonnet-5-5 or
# claude-haiku-4-5 cost less.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = slower, more thorough, more expensive)
AI_EFFORT=low
# Maximum length of an AI answer, in tokens.
AI_MAX_TOKENS=1024
# Personality/instructions for the group chatbot.
CHATBOT_PERSONA=

# =============================================================================
# Optional API keys. A command whose key is empty is disabled and hidden from .help.
# Use YOUR OWN keys; never reuse keys found in old code.
# =============================================================================

# .news  — https://newsapi.org/register
NEWSAPI_KEY=
# .weather — https://home.openweathermap.org/api_keys
OPENWEATHER_KEY=
# .emojimix — Google Cloud API key with the Tenor API enabled
TENOR_KEY=
# .tg — your own Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# .removebg — https://www.remove.bg/api
REMOVEBG_API_KEY=
# .remini — api.princetechn.com key
REMINI_API_KEY=
# .github — your repository as owner/name, e.g. myname/my-bot
GITHUB_REPO=
