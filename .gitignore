# full one holds API keys), cookies (YouTube logins), clients' data. Nothing in data/ belongs in git.
MD-main/data/
# Extra numbers (.numbers): each one's data and session, clients' details included.
MD-main/instances/
**/instances/*.removed-*/
MD-main/baileys_store.json
MD-main/assets/mention_custom.*

