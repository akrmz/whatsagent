# Pairing service configuration. Copy to .env and edit:  cp .env.example .env
# Lines starting with # are comments. Never commit the real .env file.

# REQUIRED. Secret that the web page must send. At least 16 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAIR_ACCESS_TOKEN=

# Address and port to listen on. Keep 127.0.0.1 and put a reverse proxy (nginx/Caddy)
# with HTTPS in front if you need to reach it from outside the server.
# Inside Docker this is set to 0.0.0.0 by docker-compose.yml.
HOST=127.0.0.1
PORT=8000

# Set to true ONLY when running behind a reverse proxy, so rate limiting sees real client IPs.
TRUST_PROXY=false

# Where the finished session goes:
#   local    = copied into SESSION_OUTPUT_DIR on this server (recommended; nothing leaves the server)
#   whatsapp = creds.json is sent to your own WhatsApp chat (legacy behaviour)
PAIR_DELIVERY=local

# Folder the bot reads its session from (used when PAIR_DELIVERY=local).
SESSION_OUTPUT_DIR=../MD-main/session

# If a working session already exists there: false = keep it and save the new one
# next to it as <folder>.new-<timestamp>; true = back up the old one and replace it.
PAIR_OVERWRITE=false

# Temporary working folder for pairing in progress (deleted after each attempt).
PAIR_WORK_DIR=pair-sessions

# Abuse limits.
MAX_CONCURRENT_SESSIONS=2
PAIR_TIMEOUT_SECONDS=180
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX=5

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
